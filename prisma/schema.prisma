generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  name             String          @db.VarChar(200)
  email            String          @unique @db.VarChar(200)
  role             String          @default("Customer") @db.VarChar(50)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  lastLogin        DateTime?
  passwordHash     String          @db.VarChar(255)
  stripeCustomerId String?         @db.VarChar(255)
  accounts         Account[]
  Authenticator    Authenticator[]
  sessions         Session[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       String
  expires      DateTime
  sessionToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  providers Provider[]

  @@map("categories")
}

model Provider {
  id             Int             @id @default(autoincrement())
  title          String          @db.VarChar(200)
  subtitle       String?         @db.VarChar(200)
  categoryId     Int             @map("category_id")
  description    String?
  photoUrl       String?         @map("photo_url") @db.VarChar(500)
  phone          String          @db.VarChar(20)
  email          String          @db.VarChar(200)
  address        String?         @db.VarChar(80)
  website        String?         @db.VarChar(300)
  instagram      String?         @db.VarChar(100)
  facebook       String?         @db.VarChar(100)
  youtube        String?         @db.VarChar(100)
  linkedin       String?         @db.VarChar(100)
  tiktok         String?         @db.VarChar(100)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  city           String?         @db.VarChar(50)
  complement     String?         @db.VarChar(50)
  neighborhood   String?         @db.VarChar(50)
  number         String?         @db.VarChar(10)
  state          String?         @db.Char(2)
  zipCode        String?         @db.VarChar(9)
  clicksCounters ClicksCounter[]
  category       Category        @relation(fields: [categoryId], references: [id])
  ratings        Rating[]

  @@map("providers")
}

model Rating {
  id           Int      @id @default(autoincrement())
  providerId   Int      @map("provider_id")
  reviewerName String   @map("reviewer_name") @db.VarChar(200)
  rating       Int      @db.SmallInt
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model ClicksCounter {
  id         String   @unique @default(uuid())
  providerId Int
  createdAt  DateTime @default(now()) @map("created_at")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("clicksCounter")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}
